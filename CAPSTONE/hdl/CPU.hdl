// Hack CPU: executes A- and C-instructions.
// Depends on the standard ALU, ARegister, DRegister and PC chips.
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // Select instruction constant for A-instructions, ALU result for C-instructions.
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);

    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isAInstruction, b=loadAFromC, out=loadA);
    ARegister(in=aInput, load=loadA, out=aReg, out[0..14]=addressM);

    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // a-bit (instruction[12]) chooses A or M as the ALU's y input.
    Mux16(a=aReg, b=inM, sel=instruction[12], out=aOrM);
    ALU(x=dReg, y=aOrM,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, zr=zr, ng=ng);
    Or16(a=aluOut, b=false, out=outM);

    And(a=instruction[15], b=instruction[3], out=writeM);

    // Jump bits: instruction[2]=JLT (<0), [1]=JEQ (=0), [0]=JGT (>0).
    Not(in=ng, out=notNegative);
    Not(in=zr, out=notZero);
    And(a=notNegative, b=notZero, out=isGreater);
    And(a=instruction[0], b=isGreater, out=jumpGreater);
    And(a=instruction[1], b=zr, out=jumpEqual);
    And(a=instruction[2], b=ng, out=jumpLess);
    Or(a=jumpGreater, b=jumpEqual, out=jumpGE);
    Or(a=jumpGE, b=jumpLess, out=jump);
    And(a=instruction[15], b=jump, out=pcLoad);

    PC(in=aReg, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}
